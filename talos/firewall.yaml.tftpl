apiVersion: v1alpha1
kind: NetworkDefaultActionConfig
ingress: block
---
apiVersion: v1alpha1
kind: NetworkRuleConfig
name: web-from-pods
portSelector:
  ports:
    - 80
    - 443
  protocol: tcp
ingress:
  - subnet: 10.244.0.0/16
  - subnet: ${node_ip}/32
---
apiVersion: v1alpha1
kind: NetworkRuleConfig
name: kubernetes-api
portSelector:
  ports:
    - 6443
  protocol: tcp
ingress:
  - subnet: ${lan_cidr}
  - subnet: 10.244.0.0/16
  - subnet: ${node_ip}/32
---
apiVersion: v1alpha1
kind: NetworkRuleConfig
name: talos-apid
portSelector:
  ports:
    - 50000
  protocol: tcp
ingress:
  - subnet: ${lan_cidr}
  - subnet: 10.244.0.0/16
  - subnet: ${node_ip}/32
---
apiVersion: v1alpha1
kind: NetworkRuleConfig
name: kubelet-from-pods
portSelector:
  ports:
    - 10250
  protocol: tcp
ingress:
  - subnet: 10.244.0.0/16
  - subnet: ${node_ip}/32
---
apiVersion: v1alpha1
kind: NetworkRuleConfig
name: metrics-from-pods
portSelector:
  ports:
    - 9100
    - 9962
    - 9963
    - 9964
    - 9965
    - 10254
  protocol: tcp
ingress:
  - subnet: 10.244.0.0/16
  - subnet: ${node_ip}/32
---
apiVersion: v1alpha1
kind: NetworkRuleConfig
name: control-plane-metrics-from-pods
portSelector:
  ports:
    - 2381
    - 10257
    - 10259
  protocol: tcp
ingress:
  - subnet: 10.244.0.0/16
  - subnet: ${node_ip}/32
---
apiVersion: v1alpha1
kind: NetworkRuleConfig
name: hubble-peer-from-pods
portSelector:
  ports:
    - 4244
  protocol: tcp
ingress:
  - subnet: 10.244.0.0/16
  - subnet: ${node_ip}/32
%{ for name, forward in forwards ~}
---
apiVersion: v1alpha1
kind: NetworkRuleConfig
name: relay-${name}
portSelector:
  ports:
    - ${forward.port}
  protocol: ${forward.protocol}
ingress:
  - subnet: ${relay_subnet}
  - subnet: ${lan_cidr}
  - subnet: 10.244.0.0/16
  - subnet: ${node_ip}/32
%{ endfor ~}
---
apiVersion: v1alpha1
kind: NetworkRuleConfig
name: dhcp-client
portSelector:
  ports:
    - 68
  protocol: udp
ingress:
  - subnet: 0.0.0.0/0
