apiVersion: v1alpha1
kind: NetworkDefaultActionConfig
ingress: block
---
apiVersion: v1alpha1
kind: NetworkRuleConfig
name: web
portSelector:
  ports:
    - 80
    - 443
  protocol: tcp
ingress:
  - subnet: 0.0.0.0/0
  - subnet: ::/0
---
apiVersion: v1alpha1
kind: NetworkRuleConfig
name: web-from-pods
portSelector:
  ports:
    - 80
    - 443
  protocol: tcp
ingress:
  - subnet: 10.244.0.0/16
  - subnet: ${node_ip}/32
---
