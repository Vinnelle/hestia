apiVersion: v1alpha1
kind: UserVolumeConfig
name: seaweed-hdd1
provisioning:
  diskSelector:
    match: disk.serial == '${serials.hdd1}'
  minSize: 10GB
filesystem:
  type: xfs
encryption:
  provider: luks2
  keys:
    - slot: 0
      tpm:
        checkSecurebootStatusOnEnroll: true
      lockToState: true
    - slot: 1
      static:
        passphrase: ${encryption_key}
---
