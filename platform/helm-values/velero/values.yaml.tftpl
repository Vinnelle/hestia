credentials:
  useSecret: true
  existingSecret: "velero-s3-credentials"

configuration:
  backupStorageLocation:
    - name: mega
      default: true
      provider: aws
      bucket: velero
      config:
        region: auto
        s3ForcePathStyle: "true"
        s3Url: "https://s3.${mega_s4_endpoint_domain}"
    - name: seaweedfs
      provider: aws
      bucket: velero
      credential:
        name: velero-s3-credentials
        key: cloud
      config:
        region: auto
        s3ForcePathStyle: "true"
        s3Url: "http://seaweedfs.storage.svc.cluster.local:8333"
        profile: seaweedfs
  volumeSnapshotLocation: []
  features: EnableCSI

initContainers:
  - name: velero-plugin-for-aws
    image: velero/velero-plugin-for-aws:v1.14.2
    imagePullPolicy: IfNotPresent
    volumeMounts:
      - mountPath: /target
        name: plugins

deployNodeAgent: true

podAnnotations:
  prometheus.io/scrape: "true"
  prometheus.io/port: "8085"

schedules:
  daily-mega:
    schedule: "0 3 * * *"
    template:
      ttl: "168h0m0s"
      defaultVolumesToFsBackup: true
      storageLocation: mega
  daily-seaweedfs:
    schedule: "30 3 * * *"
    template:
      ttl: "168h0m0s"
      defaultVolumesToFsBackup: true
      storageLocation: seaweedfs
